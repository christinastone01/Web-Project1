
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
    color: #222;
}

header {
    background-color: #b30824;
    color: white;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h1 {
    font-size: 25px;
    margin: 0;
}

.main {
    min-height: 500px;
    padding: 40px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;

    background-image: url("https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=1600&q=80");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

}

.welcome {
    color: white;
    max-width: 450px;
    text-shadow: 1px 1px 4px black;
}

.welcome h2 {
    font-size: 38px;
}

.welcome p {
    font-size: 18px;
}

.join-button {
    display: inline-block;
    background-color: #b30824;
    color: white;
    padding: 12px 25px;
    text-decoration: none;
    border-radius: 5px;
    margin-top: 10px;
}

.join-button:hover {
    background-color: #17264a;
}

.login {
    background-color: white;
    width: 280px;
    padding: 25px;
    border-top: 5px solid #b30824;
    border-radius: 5px;
}

.login h2 {
    color: #b30824;
    text-align: center;
    margin-top: 0;
}

.login form {
    display: flex;
    flex-direction: column;
}

.login label {
    margin-bottom: 5px;
    font-weight: bold;
}

.login input {
    padding: 10px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 4px;
}

.login button {
    background-color: #17264a;
    color: white;
    padding: 11px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

.login button:hover {
    background-color: #b30824;
}

.login p {
    text-align: center;
    font-size: 14px;
}

.login a {
    color: #b30824;
}

footer {
    background-color: #17264a;
    color: white;
    text-align: center;
    padding: 15px;
}

@media (max-width: 700px) {
    header {
        flex-direction: column;
        gap: 10px;
        text-align: center;
    }

    .main {
        flex-direction: column;
        justify-content: center;
        padding: 35px 20px;
    }

    .welcome {
        text-align: center;
    }

    .welcome h2 {
        font-size: 30px;
    }

    .login {
        width: auto;
        max-width: 320px;
    }
}

